# Configuration SentinelAI - Variables d'environnement
# Copier ce fichier en .env et remplir avec vos vraies valeurs

# Wazuh Configuration
WAZUH_API_URL=https://localhost:55000
WAZUH_API_USER=wazuh-wui
WAZUH_API_PASSWORD=your_password_here

# Indexer Configuration
WAZUH_INDEXER_URL=https://localhost:9200
WAZUH_INDEXER_USER=admin
WAZUH_INDEXER_PASSWORD=your_password_here

# Database
DATABASE_PATH=data/sentinel.db

# LLM API Configuration (à définir selon le choix final)
# LLM_API_KEY=your_api_key_here
# LLM_API_URL=https://api.provider.com/v1
# LLM_MODEL=model-name

# Logging
LOG_LEVEL=INFO
LOG_FILE=data/sentinelai.log
